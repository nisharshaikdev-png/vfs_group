NODE_ENV="development"
PORT="5000"
CLIENT_URL="http://localhost:5173"
ADDITIONAL_ALLOWED_ORIGINS=""

MONGODB_URI=""

JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-at-least-32-random-characters"
ENCRYPTION_KEY="replace-with-a-64-character-hex-key"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
EMAIL_FROM=""

SMS_PROVIDER="mock"
# Development/demo only. Never enable when a real SMS provider is configured.
MOCK_OTP_DISPLAY="true"

AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

TURNSTILE_SECRET_KEY=""
REDIS_URL=""

INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_MOBILE=""
INITIAL_ADMIN_PASSWORD=""

# Connector registration payments. Use sandbox while testing and production only after Cashfree activation.
PAYMENT_PROVIDER="mock"
CASHFREE_ENVIRONMENT="sandbox"
CONNECTOR_REGISTRATION_FEE_INR="1"
CONNECTOR_PAYMENT_EXPIRY_MINUTES="30"
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# Public HTTPS URL after deployment, for example https://api.example.com/api/v1/payments/cashfree/webhook
CASHFREE_WEBHOOK_URL=""
